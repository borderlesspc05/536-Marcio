# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local

# Auth session (cookies da área /app — complementar ao Firebase Auth)
AUTH_SECRET=cotacondo-dev-secret-change-me-in-production-32chars

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (servidor Firestore). Obrigatório para login/cadastro/API no Next.
# Firebase Console → Project settings → Service accounts → Generate new private key
# Cole o JSON inteiro em UMA linha (entre aspas). Sem isso o login falha com "default credentials".
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternativa: caminho para o arquivo baixado
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/marcio-ab7d9-firebase-adminsdk.json

# Login/cadastro usam Firebase Auth REST com NEXT_PUBLIC_FIREBASE_API_KEY (Spark OK).
# Após configurar o Admin: npm run db:setup
# Senha demo: 123456
# Contas: sindico@ / fornecedor@ / adm.master@ / ... @demo.cotacondo.com.br

# Marketing placeholders
NEXT_PUBLIC_BLOG_URL=https://blog.cotacondo.com.br
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/5500000000000
NEXT_PUBLIC_SUPPLIER_VIDEO_URL=

# Billing / Gateway: "sandbox" (simulador interno) ou "asaas"
PAYMENT_PROVIDER=asaas
# Ambiente da API Asaas: sandbox | production
ASAAS_ENVIRONMENT=sandbox
# Use chaves distintas por ambiente. Nunca exponha estas variáveis no client.
ASAAS_SANDBOX_API_KEY=
ASAAS_PRODUCTION_API_KEY=
# Token próprio configurado no webhook Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=
# Endpoint: https://SEU_DOMINIO/api/webhooks/asaas
# Segredo opcional para POST /api/webhooks/sandbox (header x-webhook-signature)
PAYMENT_WEBHOOK_SECRET=cotacondo-webhook-dev-secret
# Outros providers futuros:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAGARME_SECRET_KEY=

# E-mail (Dia 6) — sem chave = ConsoleEmailProvider (grava EmailOutbox)
# RESEND_API_KEY=
# EMAIL_FROM=CotaCondo <onboarding@resend.dev>

# Motor de distribuição (Dia 4)
# DISTRIBUTION_ENGINE_ENABLED=true

# Deploy (Spark grátis): app Next na Vercel; Firebase = Auth + Firestore + Hosting LP + rules
# Guia: doc/deploy-firebase.md · CONTEXT.md
# Sem Prisma/DATABASE_URL. Sem App Hosting até Blaze.
# npm run firebase:deploy  (exige conta com acesso a marcio-ab7d9)
# Projeto: marcio-ab7d9
